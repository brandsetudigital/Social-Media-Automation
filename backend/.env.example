# ==============================================================================
# BRANDSETU DIGITAL - INSTAGRAM & SOCIAL MEDIA AUTOMATION BACKEND ENVIRONMENT
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (SQLite default; file path relative to prisma folder)
DATABASE_URL="file:./brandsetu.db"

# JWT Authentication
JWT_SECRET="brandsetu_super_secure_jwt_secret_key_2026_change_in_production"

# ==============================================================================
# AI PROVIDER API KEYS & CONFIGURATION
# ==============================================================================

# Google Gemini API (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=""

# OpenAI API (Get from: https://platform.openai.com/api-keys)
OPENAI_API_KEY=""

# Anthropic Claude API (Get from: https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=""

# Groq Cloud API (Get from: https://console.groq.com/keys)
GROQ_API_KEY=""

# AI Provider Runtime Defaults
DEFAULT_AI_PROVIDER="gemini"
DEFAULT_AI_MODEL="gemini-2.5-flash"
AI_REQUEST_TIMEOUT_MS=15000

# ==============================================================================
# META INSTAGRAM GRAPH API CREDENTIALS
# ==============================================================================
META_APP_ID=""
META_APP_SECRET=""
META_DEFAULT_ACCESS_TOKEN=""

# ==============================================================================
# GOOGLE BUSINESS & GOOGLE DRIVE INTEGRATION
# ==============================================================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_API_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_BUSINESS_ACCESS_TOKEN=""
GOOGLE_BUSINESS_REFRESH_TOKEN=""
